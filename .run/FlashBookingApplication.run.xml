<component name="ProjectRunConfigurationManager">
  <configuration default="false" name="FlashBookingApplication (local)" type="SpringBootApplicationConfigurationType" factoryName="Spring Boot">
    <option name="ACTIVE_PROFILES" value="" />
    <module name="flash-booking" />
    <option name="SPRING_BOOT_MAIN_CLASS" value="com.flashbooking.FlashBookingApplication" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <envs>
      <!-- Credenciais (usuario/senha/banco) vem de credencias.env, lido pelo spring.config.import.
           Aqui so o que muda ao rodar fora do Docker: o Postgres do Compose fica em localhost:5433. -->
      <env name="POSTGRES_HOST" value="localhost" />
      <env name="POSTGRES_PORT" value="5433" />
      <env name="INSTANCE_ID" value="local" />
    </envs>
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
