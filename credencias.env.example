# =====================================================================
# Flash Booking - MODELO de credenciais (sem segredos)
# Copie para credencias.env e ajuste os valores (principalmente a senha).
# Usado por: docker-compose.yml (env_file) e, fora do Docker, pelo
# spring.config.import do application.yml.
# =====================================================================

# --- PostgreSQL (container e aplicacao) ---
POSTGRES_DB=flashbooking
POSTGRES_USER=flashbooking
POSTGRES_PASSWORD=troque-esta-senha
# Host/porta do Postgres vistos de FORA do Docker (ex.: rodar a API pelo IntelliJ):
# o Compose publica o banco em 127.0.0.1:5433. Dentro do Compose estes dois valores sao
# sobrescritos pelo docker-compose.yml (host = servico "postgres", porta 5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Pool de conexoes (Hikari) ---
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=20
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=3000

# --- Regras de negocio (opcionais; valores abaixo = padrao do projeto) ---
BOOKING_RESERVATION_TTL=10m
BOOKING_RESERVATION_MAX_QUANTITY=10
BOOKING_RESERVATION_EXPIRATION_JOB_ENABLED=true
BOOKING_RESERVATION_EXPIRATION_JOB_DELAY=5s
BOOKING_RESERVATION_EXPIRATION_BATCH_SIZE=100
BOOKING_AVAILABILITY_CACHE_ENABLED=true
BOOKING_AVAILABILITY_CACHE_TTL=1s
BOOKING_DB_LOCK_TIMEOUT=1s
BOOKING_DB_STATEMENT_TIMEOUT=3s
