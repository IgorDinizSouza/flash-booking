{
  "info": {
    "name": "Flash Booking - Case BackEnd",
    "description": "Roteiro do case: 5 endpoints, idempotencia, oversell, instancias, erros e expiracao. Ajuste a variavel baseUrl se necessario (Docker: http://localhost:8080; IntelliJ: http://localhost:9090).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Fluxo principal (os 5 endpoints do PDF)",
      "description": "Rode em ordem (Collection Runner). Cada passo guarda eventId/reservationId para o seguinte.",
      "item": [
        {
          "name": "1.1 POST /events - criar evento",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"capacity 5 e available 5\", () => { pm.expect(body.capacity).to.eql(5); pm.expect(body.available).to.eql(5); });",
                  "pm.test(\"header Location aponta para o evento\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/events/\" + body.id));",
                  "pm.collectionVariables.set(\"eventId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Show Teste\",\n  \"capacity\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "1.2 GET /events/{id} - consultar disponibilidade",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"available = 5\", () => pm.expect(body.available).to.eql(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}"
              ]
            }
          }
        },
        {
          "name": "1.3 POST /events/{id}/reservations - reservar 2 ingressos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idemKey\", pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"PENDING com 2 ingressos\", () => { pm.expect(body.status).to.eql(\"PENDING\"); pm.expect(body.quantity).to.eql(2); });",
                  "pm.test(\"tem expiresAt futuro\", () => pm.expect(new Date(body.expiresAt).getTime()).to.be.above(Date.now() - 60000));",
                  "pm.test(\"header Location\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/reservations/\" + body.id));",
                  "pm.test(\"responde X-Instance-Id\", () => pm.expect(pm.response.headers.get(\"X-Instance-Id\")).to.be.oneOf([\"api1\", \"api2\", \"local\"]));",
                  "pm.collectionVariables.set(\"reservationId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}",
                "reservations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "1.4 GET /reservations/{id} - consultar reserva",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"PENDING\", () => pm.expect(body.status).to.eql(\"PENDING\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{reservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{reservationId}}"
              ]
            }
          }
        },
        {
          "name": "1.5 GET /events/{id} - disponibilidade apos reservar (espera o cache)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const end = Date.now() + 2000; while (Date.now() < end) {} // espera o cache de 2s da disponibilidade"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"available = 3 (5 - 2)\", () => pm.expect(body.available).to.eql(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}"
              ]
            }
          }
        },
        {
          "name": "1.6 DELETE /reservations/{id} - cancelar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{reservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{reservationId}}"
              ]
            }
          }
        },
        {
          "name": "1.7 DELETE /reservations/{id} - cancelar de novo (idempotente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{reservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{reservationId}}"
              ]
            }
          }
        },
        {
          "name": "1.8 GET /reservations/{id} - agora CANCELLED",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"CANCELLED\", () => pm.expect(body.status).to.eql(\"CANCELLED\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reservations/{{reservationId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservations",
                "{{reservationId}}"
              ]
            }
          }
        },
        {
          "name": "1.9 GET /events/{id} - estoque devolvido uma unica vez",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const end = Date.now() + 2000; while (Date.now() < end) {} // espera o cache de 2s da disponibilidade"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"available = 5 (devolveu 2, uma vez)\", () => pm.expect(body.available).to.eql(5));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{eventId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Idempotencia",
      "item": [
        {
          "name": "2.1 Criar evento (capacity 10)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"idemEventId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"name\": \"Idempotencia\", \"capacity\": 10 }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2.2 Reservar com chave nova",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"idemKey2\", pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"sem header de replay\", () => pm.expect(pm.response.headers.has(\"Idempotent-Replayed\")).to.be.false);",
                  "pm.collectionVariables.set(\"idemReservationId\", body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey2}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{idemEventId}}/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{idemEventId}}",
                "reservations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"quantity\": 2 }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2.3 Repetir a MESMA chave e o mesmo corpo (replay)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Idempotent-Replayed: true\", () => pm.expect(pm.response.headers.get(\"Idempotent-Replayed\")).to.eql(\"true\"));",
                  "pm.test(\"mesma reserva da 2.2\", () => pm.expect(body.id).to.eql(pm.collectionVariables.get(\"idemReservationId\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey2}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{idemEventId}}/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{idemEventId}}",
                "reservations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"quantity\": 2 }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2.4 Mesma chave com corpo DIFERENTE (conflito)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "const body = pm.response.json();",
                  "pm.test(\"code = IDEMPOTENCY_KEY_CONFLICT\", () => pm.expect(body.code).to.eql(\"IDEMPOTENCY_KEY_CONFLICT\"));",
                  "pm.test(\"tem correlationId\", () => pm.expect(body.correlationId).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"formato problem+json\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idemKey2}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{idemEventId}}/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{idemEventId}}",
                "reservations"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{ \"quantity\": 3 }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2.5 Estoque descontado uma unica vez",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const end = Date.now() + 2000; while (Date.now() < end) {} // espera o cache de 2s da disponibilidade"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"available = 8 (10 - 2)\", () => pm.expect(body.available).to.eql(8));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/events/{{idemEventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "events",
                "{{idemEventId}}"
              ]
            }
          }
        }
      ]
    },
